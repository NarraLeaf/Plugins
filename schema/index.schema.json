{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NarraLeaf/Plugins/blob/master/schema/index.schema.json",
  "title": "NarraLeaf plugin registry index",
  "description": "Shape of index.json. Generated by scripts/generate-index.mjs — do not hand-edit.",
  "type": "object",
  "required": ["formatVersion", "repository", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": {
      "type": "integer",
      "const": 1,
      "description": "Bumped only on a breaking change to this shape, so clients can refuse an index they cannot read."
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/definitions/plugin" }
    }
  },
  "definitions": {
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "publisher",
        "path",
        "targets",
        "categories",
        "keywords",
        "license",
        "contributes",
        "permissions",
        "release"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "name": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string" },
        "publisher": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Source directory in this repository."
        },
        "targets": {
          "type": "array",
          "items": { "enum": ["studio", "runtime"] },
          "description": "Which entries the plugin declares."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "blueprint",
              "ui",
              "assets",
              "story",
              "workflow",
              "integration",
              "theme",
              "other"
            ]
          }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "studioVersion": {
          "type": "string",
          "description": "Advisory semver range. Studio does not enforce this yet."
        },
        "contributes": {
          "type": "object",
          "required": ["blueprintNodes", "widgets"],
          "additionalProperties": false,
          "properties": {
            "blueprintNodes": { "type": "array", "items": { "type": "string" } },
            "widgets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "permissions": {
          "type": "array",
          "description": "Copied from the manifest. Clients should surface this before installing."
        },
        "locales": {
          "type": "object",
          "description": "Localized name/description by BCP-47 tag.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "release": {
          "type": "object",
          "required": ["tag", "page", "download"],
          "additionalProperties": false,
          "description": "Derived from (id, version), not from the GitHub API.",
          "properties": {
            "tag": { "type": "string" },
            "page": { "type": "string", "format": "uri" },
            "download": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
