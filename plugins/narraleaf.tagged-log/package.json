{
  "name": "@narraleaf-plugins/tagged-log",
  "version": "1.0.0",
  "private": true,
  "description": "A blueprint node that composes a tagged log line, [tag]: message, from inspector fields and prints it.",
  "license": "MPL-2.0",
  "type": "module",
  "keywords": [
    "narraleaf",
    "narraleaf-studio-plugin",
    "blueprint",
    "log"
  ],
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "narraleaf-studio": "^0.2.0",
    "typescript": "^5.7.0"
  },
  "narraleaf": {
    "categories": [
      "blueprint"
    ],
    "studioVersion": ">=0.0.1"
  }
}
