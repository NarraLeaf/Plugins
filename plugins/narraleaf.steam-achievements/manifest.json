{
  "manifestVersion": 2,
  "id": "narraleaf.steam-achievements",
  "name": "Steam Achievements",
  "version": "0.2.0",
  "description": "Unlock Steam achievements and update stats from blueprints. Progress is saved on the player's device, and desktop builds send it to Steam whenever Steam is running.",
  "localized": {
    "zh": {
      "name": "Steam 成就",
      "description": "通过蓝图解锁 Steam 成就并更新统计数据。进度保存在玩家设备上，桌面版游戏在 Steam 运行时同步到 Steam"
    }
  },
  "publisher": "NarraLeaf Studio",
  "icon": "icon.png",
  "entries": {
    "studio": "main.js",
    "runtime": "runtime.js"
  },
  "contributes": {
    "blueprintNodes": [
      "narraleaf.steam-achievements.unlock",
      "narraleaf.steam-achievements.isUnlocked",
      "narraleaf.steam-achievements.indicateProgress",
      "narraleaf.steam-achievements.setStat",
      "narraleaf.steam-achievements.addStat",
      "narraleaf.steam-achievements.getStat",
      "narraleaf.steam-achievements.available",
      "narraleaf.steam-achievements.language",
      "narraleaf.steam-achievements.openStorePage",
      "narraleaf.steam-achievements.ownsDlc",
      "narraleaf.steam-achievements.resetAll"
    ],
    "runtimeData": [
      "narraleaf.steam-achievements.catalog"
    ],
    "runtimeCapabilities": [
      "store"
    ],
    "externalLinks": [
      "https://store.steampowered.com/app/*",
      "steam://store/*"
    ]
  },
  "permissions": []
}
